# Host ports used for local development.
FRONTEND_PORT=8081
API_PORT=3002

# Replace this placeholder when creating .env manually.
# start.bat generates a random local password automatically if .env is missing.
ANALYTICS_ADMIN_PASSWORD=replace-with-a-strong-local-password

ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
MINIMUM_CITATION_COUNT=60
